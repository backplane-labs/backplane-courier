# The release workflow supplies the trees used by the downloadable archives.
FROM gcr.io/distroless/static-debian12:nonroot
ARG TARGETARCH
WORKDIR /app
COPY linux_${TARGETARCH}/bin/courier /app/bin/courier
COPY linux_${TARGETARCH}/LICENSE /app/LICENSE
EXPOSE 8080 9400
USER nonroot:nonroot
ENTRYPOINT ["/app/bin/courier"]
